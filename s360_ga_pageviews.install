<?php

use Drupal\file\Entity\File;
use Drupal\Core\Database\Database;

/**
 * Implements hook_schema().
 */
function s360_ga_pageviews_schema() {
  $schema[S360_GA_PAGEVIEWS_TABLE_NAME] = [
    'description' => 'Stores data associated with Google Analytics.',
    'fields' => [
      'id' => [
        'description' => 'The id of the ga pageviews record.',
        'type' => 'serial',
        'length' => 10,
        'not null' => TRUE,
        'unsigned' => TRUE,
      ],
      'nid' => [
        'description' => 'The id of the node matched from page_path.',
        'type' => 'int',
        'length' => 10,
        'not null' => FALSE,
        'unsigned' => TRUE,
      ],
      'tid' => [
        'description' => 'The id of the taxonomy_term matched from page_path.',
        'type' => 'int',
        'length' => 10,
        'not null' => FALSE,
        'unsigned' => TRUE,
      ],
      'page_path' => [
        'description' => 'The pages visited, listed by URI.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'pageviews' => [
        'description' => 'Pageviews is the total number of views per page.',
        'type' => 'int',
        'length' => 10,
        'not null' => TRUE,
        'unsigned' => TRUE,
      ],
      'domain' => [
        'description' => 'What domain the page_path belongs to.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
    ],
    'indexes' => [
      'nid' => ['nid'],
      'page_path' => ['page_path'],
    ],
    'primary key' => ['id'],
  ];

  return $schema;
}

/**
 * Update {s360_ga_pageviews.nid} field to allow "null" values.
 */
function s360_ga_pageviews_update_8001() {
  $s360_ga_pageviews_fields = drupal_get_module_schema('s360_ga_pageviews', S360_GA_PAGEVIEWS_TABLE_NAME)['fields'];

  $nid_spec = $s360_ga_pageviews_fields['nid'];
  $nid_spec['not null'] = FALSE;

  $schema = Database::getConnection()->schema();
  $schema->changeField(S360_GA_PAGEVIEWS_TABLE_NAME, 'nid', 'nid', $nid_spec);
}

/**
 * Adds tid field in {s360_ga_pageviews}.
 */
function s360_ga_pageviews_update_8002() {
  $s360_ga_pageviews_fields = drupal_get_module_schema('s360_ga_pageviews', S360_GA_PAGEVIEWS_TABLE_NAME)['fields'];

  $tid_spec = $s360_ga_pageviews_fields['tid'];

  $schema = Database::getConnection()->schema();
  $schema->addField(S360_GA_PAGEVIEWS_TABLE_NAME, 'tid', $tid_spec);
}

/**
 * Implements hook_uninstall().
 */
function s360_ga_pageviews_uninstall() {
  $domains = s360_ga_pageviews_get_domains();

  foreach ($domains as $domain) {
    $domain_settings = \Drupal::config('s360_ga_pageviews.' . $domain['id'] . '.settings');
    $domain_key_file = $domain_settings->get('key_file');

    if ($domain_key_file) {
      $file = File::load(reset($domain_key_file));

      if ($file) {
        $file->delete();
      }
    }

    \Drupal::configFactory()->getEditable('s360_ga_pageviews.' . $domain['id'] . '.settings')->delete();
    \Drupal::state()->delete(S360_GA_PAGEVIEWS_CRON_LAST_RUN);
  }
}
